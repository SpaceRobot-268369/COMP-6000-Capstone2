IMAGE_TAG=main

POSTGRES_USER=capstone_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=capstone_prod
POSTGRES_PORT=5432

BACKEND_PORT=4000
FRONTEND_PORT=5173
# FRONTEND_URL: comma-separated CORS allow-list. MUST be the exact public
# origin(s) the browser sends — scheme + host + port, lowercase, no trailing
# slash. In production nginx terminates TLS on :443 and proxies the API
# same-origin under /api, so the origin is the bare https host (no port):
#   FRONTEND_URL=https://spacerobot-268369.adelaideuni.cloud,http://16.176.232.101
# A mismatch in case/scheme/port makes every credentialed POST fail CORS.
FRONTEND_URL=https://spacerobot-268369.adelaideuni.cloud,http://16.176.232.101
# VITE_API_URL: leave EMPTY in production. The frontend then calls /api
# same-origin through nginx, so no cross-origin/port is involved. Set a value
# only when the API is served from a different origin than the frontend.
VITE_API_URL=
SESSION_SECRET=change-me
APP_SECRET=change-me

AI_SERVER_LABEL=shinypokemon
AI_SSH_USER=ubuntu
AI_SSH_HOST=shinypokemon.adelaideuni.cloud
# Synchronous generation runs a diffusion forward pass on serverB and commonly
# takes 30-90s warm; a cold model load (first hit of a non-pre-warmed attempt)
# is far longer. Keep this well above that or the backend aborts the AI call and
# returns 504 ("ai-tunnel timed out"). It must also stay UNDER the nginx /api/
# proxy_read_timeout (600s); 540000ms (9 min) sits below that ceiling.
# serverB pre-warms its default models on boot (AI_PREWARM), so the warm path is
# the norm and this headroom mainly covers cold loads of non-default attempts.
AI_REQUEST_TIMEOUT_MS=540000
AI_TUNNEL_LOCAL_PORT=8000
AI_TUNNEL_REMOTE_HOST=127.0.0.1
AI_TUNNEL_REMOTE_PORT=8000
SERVERB_PEM_PATH=/home/ubuntu/.ssh/itds-eap/shinypokemon.pem
