IMAGE_TAG=main

POSTGRES_USER=capstone_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=capstone_prod
POSTGRES_PORT=5432

BACKEND_PORT=4000
FRONTEND_PORT=5173
# CORS allowlist for the backend. Comma-separated, matched EXACTLY against the
# browser's Origin header (scheme + host + port, case-sensitive). For a
# production deploy behind HTTPS this MUST be the public origin, e.g.
# FRONTEND_URL=https://spacerobot-268369.adelaideuni.cloud
# A mismatch (wrong scheme/port/case) makes the backend reject requests with a
# 500, which the UI surfaces as "Generation failed (500)".
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
VITE_API_URL=http://localhost:4000
SESSION_SECRET=change-me
APP_SECRET=change-me

AI_SERVER_LABEL=shinypokemon
AI_SSH_USER=ubuntu
AI_SSH_HOST=shinypokemon.adelaideuni.cloud
# Synchronous generation runs a diffusion forward pass on serverB and commonly
# takes 30-90s warm (longer cold). Keep this well above that or the backend
# aborts the AI call and returns 504 ("ai-tunnel timed out"). nginx /api/ allows
# 200s, so 300000ms (5 min) leaves headroom under that ceiling.
AI_REQUEST_TIMEOUT_MS=300000
AI_TUNNEL_LOCAL_PORT=8000
AI_TUNNEL_REMOTE_HOST=127.0.0.1
AI_TUNNEL_REMOTE_PORT=8000
# Optional fixed command run over SSH by ai-tunnel when serverB is reachable but
# the AI service /health check is down. Leave empty to report a yellow degraded
# state without attempting a remote restart.
AI_SERVICE_START_COMMAND=
AI_SERVICE_START_TIMEOUT_SEC=60
AI_SERVICE_START_POLL_SEC=3
AI_TUNNEL_CONTAINER_NAME=eco-ai-tunnel-server-a
# Backend auto-reconnect uses Docker's API to restart the tunnel container after
# /api/ai/health reports an offline tunnel/serverB link.
AI_RECONNECT_MODE=docker-container
AI_RECONNECT_TIMEOUT_MS=45000
AI_RECONNECT_HEALTH_TIMEOUT_MS=30000
AI_RECONNECT_POLL_MS=1500
SERVERB_PEM_PATH=/home/ubuntu/.ssh/itds-eap/shinypokemon.pem
