# Demo deployment environment. Copy to `.env` beside docker-compose.yml on the
# demo host and fill in. Do not commit the filled-in file.

# --- images ------------------------------------------------------------------
# Tag pushed by the "Demo images" workflow. Use `demo` for the branch tip, or a
# short commit sha to pin a known-good build.
IMAGE_TAG=demo

# --- database ----------------------------------------------------------------
POSTGRES_USER=capstone_user
POSTGRES_PASSWORD=change_me_before_deploying
POSTGRES_DB=capstone_demo

# --- backend -----------------------------------------------------------------
SESSION_SECRET=change_me_to_a_long_random_string

# CORS allowlist, matched EXACTLY against the browser's Origin header: scheme +
# host + port, lowercase, no trailing slash. Get this wrong and every
# credentialed POST (login, register, generate) fails.
#   http://203.0.113.10          bare IP on :80
#   http://demo.example.com      hostname on :80
#   https://demo.example.com     if you terminate TLS in front of this stack
# Comma-separate to allow more than one.
FRONTEND_URL=http://localhost

# --- public port -------------------------------------------------------------
# Host port mapped to nginx:80. Change if 80 is taken on the demo host; if you
# do, FRONTEND_URL must carry the same port (e.g. http://demo.example.com:8080).
PUBLIC_PORT=80

# --- mock think-time (ms) ----------------------------------------------------
# The fake latency that gives the staged progress UI something to narrate.
# Set all four to 0 for a snappier walkthrough.
MOCK_LATENCY_MS_PARSE=800
MOCK_LATENCY_MS_GENERATE=3000
MOCK_LATENCY_MS_ANALYSIS=1500
MOCK_LATENCY_MS_NARRATIVE=400

# Nothing in this stack does real inference, so the backend never needs the
# 9-minute window Server A allows for diffusion.
AI_REQUEST_TIMEOUT_MS=120000
