# PostgreSQL
POSTGRES_USER=capstone_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=capstone_prod

# Backend
BACKEND_PORT=4000
SESSION_SECRET=change-me
SESSION_COOKIE_SECURE=true
JWT_SECRET=change-me
APP_SECRET=change-me
WORKER_API_TOKEN=change-me
FRONTEND_URL=https://example.com

# AI worker / inference
# Server A should point to Server B or a private worker endpoint when enabled.
AI_SERVER_URL=http://shinypokemon:8000

# Frontend build
# Leave empty for same-origin /api calls through nginx.
VITE_API_URL=
