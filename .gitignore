# Model checkpoints
# Layout: model/{candidates/<member>/<run-id>, production/<role>}/
# Binaries (.pt, .safetensors, .bin, .ckpt) belong in DVC, not git.
# Only metadata (.dvc pointers, README, *.json, *.yaml) is committed.
model/**/*.pt
model/**/*.safetensors
model/**/*.bin
model/**/*.ckpt

# Acoustic AI — large computed data artifacts (DVC-tracked, not git)
acoustic_ai/data/shared/wavs/
acoustic_ai/data/shared/spectrograms/
acoustic_ai/data/module_b/weather_assets/
acoustic_ai/data/module_c/event_snippets/
acoustic_ai/data/module_c/birdnet_labels/
acoustic_ai/data/ambient/latents/

# HiFi-GAN speech-domain cache (not needed — using ecoacoustic vocoder)
acoustic_ai/hifigan_cache/

# Debug and scratch output
debug/
*.wav
acoustic_ai/=*

